{
  "name": "eunockweb/safepay",
  "description": "Laravel Escrow package for FedaPay",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Eunock",
      "email": "izumishinishi7@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
    "fedapay/fedapay-php": "^0.4"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Safepay\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Safepay\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Safepay\\SafePayServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
